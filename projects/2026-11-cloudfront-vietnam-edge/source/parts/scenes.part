<div class="cam" id="cam-e1" style="opacity:0.3;"><img class="mapimg" src="assets/map/world-dots.svg" alt=""><svg class="mapov" viewBox="0 0 1080 1920" aria-hidden="true"><g id="e1-edges"><circle cx="174.2" cy="552.3" r="7" style="fill:var(--term-text)"/><circle cx="304.0" cy="626.7" r="7" style="fill:var(--term-text)"/><circle cx="347.6" cy="538.9" r="7" style="fill:var(--term-text)"/><circle cx="454.7" cy="482.8" r="7" style="fill:var(--term-text)"/><circle cx="376.2" cy="571.2" r="7" style="fill:var(--term-text)"/><circle cx="290.1" cy="574.8" r="7" style="fill:var(--term-text)"/><circle cx="401.4" cy="475.2" r="7" style="fill:var(--term-text)"/><circle cx="316.6" cy="658.4" r="7" style="fill:var(--term-text)"/><circle cx="503.0" cy="774.4" r="7" style="fill:var(--term-text)"/><circle cx="378.3" cy="527.6" r="7" style="fill:var(--term-text)"/><circle cx="866.3" cy="432.9" r="7" style="fill:var(--term-text)"/><circle cx="883.6" cy="489.7" r="7" style="fill:var(--term-text)"/></g></svg></div>
